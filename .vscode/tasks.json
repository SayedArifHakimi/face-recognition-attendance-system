{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "HCE Mandatory Verification",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe hce_check.py",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run All Tests",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe -m unittest discover -v -p \"test_*.py\"; .\\.venv\\Scripts\\python.exe test_face_id.py",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "problemMatcher": []
    },
    {
      "label": "Run System Diagnostics",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe diagnostics.py",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Latency & Scale Benchmark",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe benchmark.py",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "problemMatcher": []
    },
    {
      "label": "Run Biometric Gallery Calibration",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe evaluate_gallery.py --sweep",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "problemMatcher": []
    },
    {
      "label": "Start Admin Web Portal",
      "type": "shell",
      "command": ".\\.venv\\Scripts\\python.exe admin_web.py",
      "options": {
        "cwd": "${workspaceFolder}/attendance-system"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
